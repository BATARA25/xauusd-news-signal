//@version=6
indicator("BATARA XAUUSD Institutional Signal v1", "BATARA XAUUSD INS v1", overlay=true, max_labels_count=500)

// === Inputs ===
groupTrend = "Trend Engine"
fastLen = input.int(21, "Fast EMA", minval=2, group=groupTrend)
slowLen = input.int(55, "Slow EMA", minval=3, group=groupTrend)
htf = input.timeframe("60", "Higher Timeframe", group=groupTrend)
htfEmaLen = input.int(200, "HTF EMA", minval=20, group=groupTrend)

groupMomentum = "Momentum"
rsiLen = input.int(14, "RSI Length", minval=2, group=groupMomentum)
rsiBull = input.float(55, "Bull RSI Threshold", minval=50, maxval=80, group=groupMomentum)
rsiBear = input.float(45, "Bear RSI Threshold", minval=20, maxval=50, group=groupMomentum)
macdFast = input.int(12, "MACD Fast", minval=2, group=groupMomentum)
macdSlow = input.int(26, "MACD Slow", minval=3, group=groupMomentum)
macdSignal = input.int(9, "MACD Signal", minval=2, group=groupMomentum)

groupVol = "Volatility / Structure"
atrLen = input.int(14, "ATR Length", minval=2, group=groupVol)
atrMult = input.float(1.5, "ATR Stop Multiplier", minval=0.5, step=0.1, group=groupVol)
breakoutLen = input.int(20, "Structure Lookback", minval=5, group=groupVol)
volumeLen = input.int(20, "Volume Average", minval=5, group=groupVol)
volumeFactor = input.float(1.15, "Volume Confirmation", minval=0.5, step=0.05, group=groupVol)

groupSignal = "Signal Engine"
minScore = input.int(70, "Minimum Signal Score", minval=50, maxval=100, group=groupSignal)
cooldownBars = input.int(5, "Signal Cooldown Bars", minval=0, group=groupSignal)
confirmedOnly = input.bool(true, "Signals Only On Confirmed Bars", group=groupSignal)
showDashboard = input.bool(true, "Show Dashboard", group=groupSignal)
showLevels = input.bool(true, "Show Entry / SL / TP", group=groupSignal)

// === Core calculations ===
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
htfClose = request.security(syminfo.tickerid, htf, close, lookahead=barmerge.lookahead_off)
htfEma = request.security(syminfo.tickerid, htf, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)

rsi = ta.rsi(close, rsiLen)
[macdLine, macdSig, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
atr = ta.atr(atrLen)
volAvg = ta.sma(volume, volumeLen)
volConfirmed = na(volume) ? true : volume > volAvg * volumeFactor

swingHigh = ta.highest(high, breakoutLen)[1]
swingLow = ta.lowest(low, breakoutLen)[1]
bullBreak = close > swingHigh
bearBreak = close < swingLow

bullTrend = emaFast > emaSlow and close > emaFast and htfClose > htfEma
bearTrend = emaFast < emaSlow and close < emaFast and htfClose < htfEma
bullMomentum = rsi >= rsiBull and macdHist > 0
bearMomentum = rsi <= rsiBear and macdHist < 0

// === Score engine: independent confirmations ===
bullScore = (bullTrend ? 35 : 0) + (bullMomentum ? 25 : 0) + (bullBreak ? 20 : 0) + (volConfirmed ? 10 : 0) + (close > htfEma ? 10 : 0)
bearScore = (bearTrend ? 35 : 0) + (bearMomentum ? 25 : 0) + (bearBreak ? 20 : 0) + (volConfirmed ? 10 : 0) + (close < htfEma ? 10 : 0)

rawLong = bullScore >= minScore and bullTrend and bullMomentum
rawShort = bearScore >= minScore and bearTrend and bearMomentum
barOK = not confirmedOnly or barstate.isconfirmed

var int lastSignalBar = na
canSignal = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars
longSignal = rawLong and barOK and canSignal
shortSignal = rawShort and barOK and canSignal

if longSignal or shortSignal
    lastSignalBar := bar_index

// === Trade levels ===
longEntry = close
longSL = longEntry - atr * atrMult
longRisk = longEntry - longSL
longTP1 = longEntry + longRisk
longTP2 = longEntry + longRisk * 2.0
longTP3 = longEntry + longRisk * 3.0

shortEntry = close
shortSL = shortEntry + atr * atrMult
shortRisk = shortSL - shortEntry
shortTP1 = shortEntry - shortRisk
shortTP2 = shortEntry - shortRisk * 2.0
shortTP3 = shortEntry - shortRisk * 3.0

// === Plots ===
plot(emaFast, "EMA Fast", linewidth=2)
plot(emaSlow, "EMA Slow", linewidth=2)
plot(htfEma, "HTF EMA", linewidth=2)

plotshape(longSignal, title="BUY", style=shape.labelup, location=location.belowbar, text="BUY", size=size.small)
plotshape(shortSignal, title="SELL", style=shape.labeldown, location=location.abovebar, text="SELL", size=size.small)

var line entryLine = na
var line slLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na

if showLevels and longSignal
    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    entryLine := line.new(bar_index, longEntry, bar_index + 20, longEntry, extend=extend.right)
    slLine := line.new(bar_index, longSL, bar_index + 20, longSL, extend=extend.right)
    tp1Line := line.new(bar_index, longTP1, bar_index + 20, longTP1, extend=extend.right)
    tp2Line := line.new(bar_index, longTP2, bar_index + 20, longTP2, extend=extend.right)
    tp3Line := line.new(bar_index, longTP3, bar_index + 20, longTP3, extend=extend.right)

if showLevels and shortSignal
    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    entryLine := line.new(bar_index, shortEntry, bar_index + 20, shortEntry, extend=extend.right)
    slLine := line.new(bar_index, shortSL, bar_index + 20, shortSL, extend=extend.right)
    tp1Line := line.new(bar_index, shortTP1, bar_index + 20, shortTP1, extend=extend.right)
    tp2Line := line.new(bar_index, shortTP2, bar_index + 20, shortTP2, extend=extend.right)
    tp3Line := line.new(bar_index, shortTP3, bar_index + 20, shortTP3, extend=extend.right)

// === Dashboard ===
var table dash = table.new(position.top_right, 2, 7)

if barstate.islast and showDashboard
    bias = bullScore > bearScore ? "BULLISH" : bearScore > bullScore ? "BEARISH" : "NEUTRAL"
    score = math.max(bullScore, bearScore)
    table.cell(dash, 0, 0, "BATARA XAUUSD")
    table.cell(dash, 1, 0, "INSTITUTIONAL")
    table.cell(dash, 0, 1, "Bias")
    table.cell(dash, 1, 1, bias)
    table.cell(dash, 0, 2, "Bull Score")
    table.cell(dash, 1, 2, str.tostring(bullScore))
    table.cell(dash, 0, 3, "Bear Score")
    table.cell(dash, 1, 3, str.tostring(bearScore))
    table.cell(dash, 0, 4, "RSI")
    table.cell(dash, 1, 4, str.tostring(rsi, "#.0"))
    table.cell(dash, 0, 5, "ATR")
    table.cell(dash, 1, 5, str.tostring(atr, "#.00"))
    table.cell(dash, 0, 6, "Signal")
    table.cell(dash, 1, 6, longSignal ? "BUY" : shortSignal ? "SELL" : "WAIT")

// === Alerts ===
alertcondition(longSignal, "BATARA BUY", "BATARA XAUUSD BUY | {{ticker}} | Price={{close}}")
alertcondition(shortSignal, "BATARA SELL", "BATARA XAUUSD SELL | {{ticker}} | Price={{close}}")
alertcondition(longSignal or shortSignal, "BATARA SIGNAL", "BATARA XAUUSD SIGNAL | {{ticker}} | Price={{close}}")
